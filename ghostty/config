font-family="JetBrainsMono Nerd Font Mono"
font-size=15
theme = Catppuccin Mocha

# Slightly transparent background with macOS blur.
background-opacity = 0.95
background-blur = true

# Terminal features
shell-integration = detect
shell-integration-features = cursor,sudo,title
scrollback-limit = 10000
copy-on-select = clipboard

# Fix: dead-key accent composition (Option+e, Option+n, Option+c, etc.)
# being swallowed instead of producing á/ñ/ç. Leaving this unset breaks
# macOS accent composition on some Ghostty versions.
macos-option-as-alt = false
